# KDE Gear apps: the same set as Arch's `kde-applications` group
# (https://archlinux.org/groups/x86_64/kde-applications/), mapped to
# nixpkgs' kdePackages. KDE Connect and Partition Manager are enabled through
# their NixOS modules instead (firewall ports / privileged helper).
# Left out: neochat and itinerary (their Matrix support needs olm, which
# nixpkgs marks insecure).
{ pkgs, ... }:

{
  programs.kdeconnect.enable = true;
  programs.partition-manager.enable = true;

  environment.systemPackages = with pkgs.kdePackages; [
    accessibility-inspector
